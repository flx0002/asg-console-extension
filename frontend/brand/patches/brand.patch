+          </Col>
+          <Col span={6}>
+            <Card size="small"><Statistic title={t('auditChain.highRiskSessions')} value={listStats.highRiskSessions} valueStyle={{ color: listStats.highRiskSessions > 0 ? '#cf1322' : '#3f8600' }} /></Card>
+          </Col>
