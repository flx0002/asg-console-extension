+
+  const handlePresetSave = () => {
+    if (!editRuleName.trim()) {
+      message.warning(t('aiContentSec.keywordFilter.ruleNamePlaceholder'));
+      return;
+    }
+    const keywords = editKeywords.split(',').map(k => k.trim()).filter(Boolean);
