+      newRules[editingIndex] = newRule;
+    }
+    updateField(field, newRules);
+    setModalVisible(false);
+  };
+
+  const getRuleColumns = (type: 'deny' | 'allow') => [
+    {
+      title: t('aiContentSec.promptGuard.ruleName'),
+      dataIndex: 'name',
+      key: 'name',
+    },
+    {
+      title: t('aiContentSec.promptGuard.regex'),
+      dataIndex: 'regex',
