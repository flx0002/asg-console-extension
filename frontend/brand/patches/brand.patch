+  };
+
+  const handlePresetDelete = (index: number) => {
+    setPresetRules(prev => prev.filter((_, i) => i !== index));
+  };
+
+  const handleModalOk = () => {
+    if (modalType === 'custom') {
+      handleCustomSave();
+    } else {
+      handlePresetSave();
