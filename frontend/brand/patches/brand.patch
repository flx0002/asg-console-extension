+import yaml from 'js-yaml';
+
+const PLUGIN_NAME = 'ai-prompt-guard';
+const EVENT_TYPE_FILTER = 'prompt_injection';
+
+interface RuleItem {
+  key: string;
+  name: string;
+  regex: string;
